<UserControl x:Class="GuildManager.Client.View.AdventurerRosterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GuildManager.Client.View.Controls">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="60,40">
            <ItemsControl ItemsSource="{Binding Adventurers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="160" Height="240" Margin="10"
                                Background="#EFE0BE" BorderBrush="#3B2412" BorderThickness="2"
                                CornerRadius="6">
                            <StackPanel Margin="8">
                                <Image Source="{Binding PortraitPath}" Height="120"/>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"
                                           HorizontalAlignment="Center" Foreground="#3B2412" Margin="0,6,0,0"/>
                                <TextBlock  FontSize="12" Foreground="#5C4A32" HorizontalAlignment="Center" FontWeight="Bold">
                                    <Run Text="{Binding ClassName}"/>
                                    <Run Text=" lvl "/>
                                    <Run Text="{Binding Level}"/>
                                </TextBlock>
                                <TextBlock  FontSize="12" Foreground="#5C4A32" HorizontalAlignment="Center" FontWeight="Bold">
                                    <Run Text="PV : " Foreground= "#C62828"/>
                                    <Run Text="{Binding Health}"/>
                                    <Run Text="    DEF : " Foreground= "#78909C"/>
                                    <Run Text="{Binding Defense}"/>
                                </TextBlock>
                                <TextBlock  FontSize="12" Foreground="#5C4A32" HorizontalAlignment="Center" FontWeight="Bold">
                                    <Run Text="AP : " Foreground= "#D4AF37"/>
                                    <Run Text="{Binding PhysicAttack}"/>
                                    <Run Text="    AM : " Foreground= "#1976D2"/>
                                    <Run Text="{Binding MagicAttack}"/>
                                </TextBlock>
                                <Border Background="{Binding StatusColor}" CornerRadius="4"
                                        Margin="0,6,0,0" Padding="4,2">
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <controls:BackButton HorizontalAlignment="Left" VerticalAlignment="Top" Width="60" Height="60" Margin="20"/>
    </Grid>
</UserControl>