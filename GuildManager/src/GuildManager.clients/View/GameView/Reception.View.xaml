<UserControl x:Class="GuildManager.Client.View.GameView.ReceptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GuildManager.Client.View.Controls">
<Viewbox Stretch="Uniform">
    <Canvas Width="1697" Height="952">
        <Image Source="Assets/UI/Table_avanturier.png" Width="1697" Height="952"/>

        <!-- Book Adventurer -->
        <controls:FantasyMenuButton NormalImage="Assets/UI/button_aventurier.png"
                        HoverImage="Assets/UI/button_aventurier_hover.png"
                        Clicked="OnMyAdventurersClicked"
                        Canvas.Left="180" Canvas.Top="180"
                        Width="460" Height="520"/>

        <!--Parchemin recrutement-->

        <controls:FantasyMenuButton NormalImage="Assets/UI/button_recrutement.png"
                        HoverImage="Assets/UI/button_recrutement_hover.png"
                        Clicked="OnRecruitClicked"
                        Canvas.Left="1050" Canvas.Top="200"
                        Width="520" Height="480"/> 

    </Canvas>
    </Viewbox>
    </UserControl>                       