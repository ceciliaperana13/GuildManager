<UserControl x:Class="GuildManager.Client.View.VictoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GuildManager.Client.View.Controls">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="VICTOIRE" FontSize="64" FontWeight="Bold"
                       Foreground="#F2D98A" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock Text="{Binding Game.playerName, StringFormat='Bravo, {0} ! Votre guilde est entrée dans la légende.'}"
                       FontSize="20" Foreground="#3B2412" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding Game.turn, StringFormat='Partie terminée en {0} tours.'}"
                       FontSize="16" Foreground="#3B2412" HorizontalAlignment="Center" Margin="0,0,0,40"/>

                <controls:FantasyMenuButton NormalImage="/Assets/UI/Rejouer.png"
                             HoverImage="/Assets/UI/Rejouer_hover.png"
                             Clicked="OnReturnToMenuClicked"
                             Width="360" Height="90"/>
        </StackPanel>
    </Grid>
</UserControl>