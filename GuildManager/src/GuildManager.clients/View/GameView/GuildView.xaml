<UserControl x:Class="GuildManager.Client.View.GuildView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GuildManager.Client.View.Controls">
    <Viewbox Stretch="Uniform">
        <Canvas x:Name="RootCanvas" Width="1867" Height="819">
            <Image Source="/Assets/Backgrounds/guilde_background.png" Width="1867" Height="819"/>
            <!--resource bar  -->
            <controls:ResourceBar Gold="{Binding Gold}" Food="{Binding Food}" Prestige="{Binding Prestige}"
                       Canvas.Left="20" Canvas.Top="10" Width="950" Height="422"/>
            <!-- Store : l'échoppe à gauche -->
            <controls:HoverHotspot Canvas.Left="10" Canvas.Top="180"
                                    Width="520" Height="460"
                                    Clicked="OnStoreClicked"/>

            <!-- Quêtes : le tableau au centre -->
            <controls:HoverHotspot Canvas.Left="530" Canvas.Top="190"
                                    Width="630" Height="460"
                                    Clicked="OnQuestBoardClicked"/>

            <!-- Recrutement : le bureau de réception à droite -->
            <controls:HoverHotspot Canvas.Left="1420" Canvas.Top="375"
                                    Width="460" Height="260"
                                    Clicked="OnReceptionClicked"/>
            <!-- Flip : le bureau de flip à droite -->  
            <controls:FantasyMenuButton NormalImage="/Assets/UI/Coin_victory.png"
                            HoverImage="/Assets/UI/Coin_victory.png"
                            Clicked="OnFlipClicked"
                            Canvas.Left="1520" Canvas.Top="750"
                            Width="460" Height="160"/>
            <controls:CoinFlip x:Name="GuildCoinFlip"
                               Visibility="Collapsed"
                               IsHitTestVisible="False"
                               Canvas.Left="740" Canvas.Top="350"
                               Width="220" Height="220"/>

            <!-- Joueurs connectés -->
            <Border Canvas.Left="20" Canvas.Top="20" Background="#AA000000"
                    CornerRadius="6" Padding="10">
                <StackPanel>
                    <TextBlock Text="Joueurs connectés" Foreground="Gold" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ItemsControl x:Name="OnlinePlayersList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="White" Text="{Binding}" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Canvas>
    </Viewbox>
</UserControl>