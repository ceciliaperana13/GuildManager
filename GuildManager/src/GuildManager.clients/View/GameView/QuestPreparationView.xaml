<UserControl x:Class="GuildManager.Client.View.QuestPreparationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GuildManager.Client.View.Controls">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Les 3 slots d'aventurier, chacun avec son slot d'équipement en dessous -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <StackPanel Margin="16,0">
                    <Button Click="OnSlot0Click" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate>
                        </Button.Template>
                        <Grid Width="140" Height="140">
                            <Image Source="/Assets/UI/portrait_slot.png" Stretch="Uniform"/>
                            <Image x:Name="Portrait0" Source="{Binding SelectedSlots[0].PortraitPath}" Stretch="Uniform" Width="90" Height="90"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Click="OnEquipment0Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,10,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate>
                        </Button.Template>
                        <Image Source="/Assets/UI/Equipement_icon.png" Width="80" Height="80" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <StackPanel Margin="16,0">
                    <Button Click="OnSlot1Click" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate>
                        </Button.Template>
                        <Grid Width="140" Height="140">
                            <Image Source="/Assets/UI/portrait_slot.png" Stretch="Uniform"/>
                            <Image x:Name="Portrait1" Source="{Binding SelectedSlots[1].PortraitPath}" Stretch="Uniform" Width="90" Height="90"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Click="OnEquipment1Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,10,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate>
                        </Button.Template>
                        <Image Source="/Assets/UI/Equipement_icon.png" Width="80" Height="80" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <StackPanel Margin="16,0">
                    <Button Click="OnSlot2Click" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate>
                        </Button.Template>
                        <Grid Width="140" Height="140">
                            <Image Source="/Assets/UI/portrait_slot.png" Stretch="Uniform"/>
                            <Image x:Name="Portrait2" Source="{Binding SelectedSlots[2].PortraitPath}" Stretch="Uniform" Width="90" Height="90"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Click="OnEquipment2Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,10,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate>
                        </Button.Template>
                        <Image Source="/Assets/UI/Equipement_icon.png" Width="80" Height="80" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

            </StackPanel>

            <!-- Jauge de % de victoire -->
            <Grid Canvas.Left="162" Canvas.Top="720" Width="700" Height="233">
                    <Image Source="/Assets/UI/victory_bar.png" Stretch="Fill"/>
                    <Border x:Name="FillBar" Background="#66FFD700" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Width="0" Height="40" Margin="90,0,90,0" CornerRadius="4"/>
                    <TextBlock x:Name="PercentageText" Text="--%" FontSize="24" FontWeight="Bold"
                                Foreground="#3B2412" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <controls:FantasyMenuButton NormalImage="/Assets/UI/bouton_jouer.png"
                                         HoverImage="/Assets/UI/bouton_jouer_hover.png"
                                         Clicked="OnLaunchQuestClicked"
                                         Canvas.Left="362" Canvas.Top="1000" Width="300" Height="80"/>
        </StackPanel>

        <controls:BackButton HorizontalAlignment="Left" VerticalAlignment="Top" Width="60" Height="60" Margin="20"/>
         <controls:AdventurerPickerPopup x:Name="Picker" Visibility="Collapsed"
                                         AdventurerPicked="OnAdventurerPicked" CancelRequested="OnPickerCancelled"/>
        <controls:TextPopup x:Name="textPopup" Visibility="Collapsed"
                                        CancelRequested="OnTextPopupCancelled"/>
    </Grid>
</UserControl>