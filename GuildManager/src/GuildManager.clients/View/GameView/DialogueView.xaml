<UserControl x:Class="GuildManager.Client.View.DialogueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GuildManager.Client.View.Controls"
             xmlns:conv="clr-namespace:GuildManager.Client.View.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <!-- 1. Le fond -->
        <Image Source="{Binding BackgroundPath}" Stretch="UniformToFill"/>

        <!-- 2. L'illustration du personnage qui parle -->
        <Image Source="{Binding CharacterImagePath}" Stretch="Uniform"
               HorizontalAlignment="Left" VerticalAlignment="Bottom"
               Height="320" Margin="40,0,0,180"
               Visibility="{Binding CharacterImagePath, Converter={StaticResource NullToVisibilityConverter}}"/>

        <!-- 3. La boîte de dialogue -->
        <StackPanel VerticalAlignment="Bottom" Margin="40,0,40,40">

            <Border Background="#2E2318" BorderBrush="#C9A24B" BorderThickness="2" CornerRadius="4"
                    Padding="14,4" HorizontalAlignment="Left" Margin="60,0,0,8">
                <TextBlock Text="{Binding Speaker}" FontWeight="Bold" FontSize="15" Foreground="#F2D98A"/>
            </Border>

            <Grid>
                <Image Source="/Assets/UI/dialogue_box.png" Stretch="Fill" Height="160"/>

                <TextBlock Text="{Binding CurrentText}" Foreground="#3B2412" FontSize="18"
                           Margin="60,20,110,20" TextWrapping="Wrap" VerticalAlignment="Center"/>

                <Image Source="/Assets/UI/arrow_next.png" Width="48" Height="48"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,25,0"
                       Visibility="{Binding HasChoices, Converter={StaticResource InverseBoolToVis}}"
                       MouseLeftButtonDown="OnAdvanceClicked" Cursor="Hand"/>
            </Grid>

        </StackPanel>

        <!-- 4. Les boutons de choix -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,210"
                    Visibility="{Binding HasChoices, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding CurrentChoices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:DialogueChoiceButton Text="{Binding Text}" Width="400" Height="60"
                                                        Margin="0,4" Clicked="OnChoiceClicked"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

    </Grid>
</UserControl>