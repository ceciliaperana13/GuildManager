<UserControl x:Class="GuildManager.Client.View.QuestListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GuildManager.Client.View.Controls">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="80,60">
            <ItemsControl ItemsSource="{Binding Quests}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:QuestCard Margin="12" Clicked="OnQuestCardClicked"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <controls:BackButton HorizontalAlignment="Left" VerticalAlignment="Top" Width="60" Height="60" Margin="20"/>
    </Grid>
</UserControl>