<UserControl x:Class="GuildManager.Client.View.DefeatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GuildManager.Client.View.Controls">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="DÉFAITE" FontSize="64" FontWeight="Bold"
                       Foreground="#8A9CB0" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock Text="{Binding Reason}"
                       FontSize="20" Foreground="#3B2412" HorizontalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="600" Margin="0,0,0,40"/>

            <controls:FantasyMenuButton NormalImage="/Assets/UI/Rejouer.png"
                             HoverImage="/Assets/UI/Rejouer_hover.png"
                             Clicked="OnReturnToMenuClicked"
                             Width="360" Height="90"/>
        </StackPanel>
    </Grid>
</UserControl>