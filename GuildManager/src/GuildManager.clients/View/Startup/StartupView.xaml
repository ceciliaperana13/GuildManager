<UserControl x:Class="MonProjet.View.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="GuildManager" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Premier choix : Solo ou Multijoueur -->
            <StackPanel x:Name="MainChoicePanel">
                <Button x:Name="SoloButton" Content="Jouer en solo"
                        Height="40" Margin="0,0,0,10" Click="SoloButton_Click"/>
                <Button x:Name="MultiplayerButton" Content="Multijoueur"
                        Height="40" Margin="0,0,0,10" Click="MultiplayerButton_Click"/>
            </StackPanel>

            <!-- Deuxième choix, affiché seulement après "Multijoueur" -->
            <StackPanel x:Name="MultiplayerChoicePanel" Visibility="Collapsed" Margin="0,10,0,0">
                <Button x:Name="HostButton" Content="Héberger cette partie"
                        Height="40" Margin="0,0,0,10" Click="HostButton_Click"/>
                <Button x:Name="JoinButton" Content="Rejoindre une partie"
                        Height="40" Margin="0,0,0,10" Click="JoinButton_Click"/>

                <StackPanel x:Name="JoinPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="Adresse IP de l'hôte :" Margin="0,0,0,4"/>
                    <TextBox x:Name="IpTextBox" Height="26" Margin="0,0,0,10"/>
                    <Button Content="Se connecter" Height="36" Click="ConnectToHost_Click"/>
                </StackPanel>

                <Button Content="&lt; Retour" Margin="0,10,0,0" Click="Back_Click"
                        HorizontalAlignment="Left" BorderThickness="0" Background="Transparent"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" Margin="0,15,0,0" TextWrapping="Wrap"
                       Foreground="Gray" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>