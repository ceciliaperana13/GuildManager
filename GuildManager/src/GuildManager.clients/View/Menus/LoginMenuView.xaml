<UserControl x:Class="GuildManager.Client.View.LoginMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GuildManager.Client.View.Controls">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Connexion" Foreground="Gold" FontSize="28"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <controls:FantasyTextBox x:Name="UsernameBox" Width="400" Height="70" Margin="0,6"/>
            <controls:FantasyTextBox x:Name="PasswordBox" Width="400" Height="70" Margin="0,6"/>

            <controls:FantasyMenuButton NormalImage="/Assets/UI/bouton_se_connecter.png"
                                         HoverImage="/Assets/UI/bouton_se_connecter_hover.png"
                                         Clicked="OnLoginClicked" Width="300" Height="70" Margin="0,20,0,8"/>

            <controls:FantasyMenuButton NormalImage="/Assets/UI/bouton_retour.png"
                                         HoverImage="/Assets/UI/bouton_retour_hover.png"
                                         Clicked="OnBackClicked" Width="300" Height="70" Margin="0,8"/>
        </StackPanel>
    </Grid>

</UserControl> 