<UserControl x:Class="GuildManager.Client.View.MainMenuView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:controls="clr-namespace:GuildManager.Client.View.Controls">

	<Grid>
		<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
			<TextBlock Text="Guild Manager" Foreground="Gold" FontSize="28" 
					   HorizontalAlignment="Center"/>

			<controls:FantasyMenuButton NormalImage="/Assets/UI/bouton_jouer.png"
										 HoverImage="/Assets/UI/bouton_jouer_hover.png"
										 Clicked="OnPlayButtonClicked" Margin="0,8" Width="220"/>

			<controls:FantasyMenuButton NormalImage="/Assets/UI/bouton_option.png"
										 HoverImage="/Assets/UI/bouton_option_hover.png"
										 Clicked="OnOptionsButtonClicked" Margin="0,8" Width="220"/>

			<controls:FantasyMenuButton NormalImage="/Assets/UI/bouton_quitter.png"
										 HoverImage="/Assets/UI/bouton_quitter_hover.png"
										 Clicked="OnQuitButtonClicked" Margin="0,8" Width="220"/>
										 
		</StackPanel>
	</Grid>
</UserControl>