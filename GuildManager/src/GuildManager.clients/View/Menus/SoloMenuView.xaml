<UserControl x:Class="GuildManager.Client.View.SoloMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GuildManager.Client.View.Controls">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <controls:FantasyMenuButton x:Name="NewGameButton"
                                         NormalImage="/Assets/UI/nouvelle_p.png"
                                         HoverImage="/Assets/UI/nouvelle_p_hover.png"
                                         Clicked="OnNewGameClicked"
                                         Width="420" Height="110"
                                         Margin="0,0,0,24"/>

            <controls:FantasyMenuButton x:Name="ContinueButton"
                                         NormalImage="/Assets/UI/continuer.png"
                                         HoverImage="/Assets/UI/continuer_hover.png"
                                         Clicked="OnContinueClicked"
                                         IsEnabled="{Binding HasSave}"
                                         Width="420" Height="110"/>

            <TextBlock x:Name="StatusText" HorizontalAlignment="Center" Margin="0,20,0,0"
                       Foreground="#3B2412" FontSize="16"/>
        </StackPanel>

        <controls:BackButton HorizontalAlignment="Left" VerticalAlignment="Top" Width="60" Height="60" Margin="20"/>
    </Grid>
</UserControl>