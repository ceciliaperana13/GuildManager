<UserControl x:Class="GuildManager.Client.View.Controls.ResourceBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid Width="700" Height="95">
        <Image Source="/Assets/UI/barre_UID.png" Stretch="Fill"/>

        <!-- Icône Or, dans le cercle de gauche -->
        <Image Source="/Assets/UI/gold_icon.png" Width="55" Height="55"
               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="115,0,0,0"/>
        <TextBlock Text="{Binding Gold, ElementName=Root}" FontSize="22" FontWeight="Bold"
                   Foreground="#F2D98A" HorizontalAlignment="Left" VerticalAlignment="Center"
                   Margin="185,0,0,0"/>

        <!-- Icône Nourriture, dans le cercle du milieu-droit -->
        <Image Source="/Assets/UI/icon_food.png" Width="55" Height="55"
               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="390,0,0,0"/>
        <TextBlock Text="{Binding Food, ElementName=Root}" FontSize="22" FontWeight="Bold"
                   Foreground="#F2D98A" HorizontalAlignment="Left" VerticalAlignment="Center"
                   Margin="460,0,0,0"/>
    </Grid>
</UserControl>