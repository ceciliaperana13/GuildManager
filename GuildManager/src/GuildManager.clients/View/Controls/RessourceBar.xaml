<UserControl x:Class="GuildManager.Client.View.Controls.ResourceBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Viewbox Stretch="Uniform">
        <Canvas Width="1882" Height="836">
            <Image Source="/Assets/UI/Barre_UID.png" Width="1882" Height="836"/>

            <!-- Or -->
            <Image Source="/Assets/UI/gold_icon.png" Width="110" Height="110" Canvas.Left="250" Canvas.Top="60"/>
            <TextBlock Text="{Binding Gold, ElementName=Root}" FontSize="46" FontWeight="Bold"
                       Foreground="#F2D98A" Canvas.Left="400" Canvas.Top="90"/>

            <!-- Nourriture -->
            <Image Source="/Assets/UI/icon_food.png" Width="110" Height="110" Canvas.Left="890" Canvas.Top="60"/>
            <TextBlock Text="{Binding Food, ElementName=Root}" FontSize="46" FontWeight="Bold"
                       Foreground="#F2D98A" Canvas.Left="1040" Canvas.Top="90"/>

            <!-- Prestige -->
            <Image Source="/Assets/UI/prestige_icon.png" Width="110" Height="110" Canvas.Left="1530" Canvas.Top="60"/>
            <TextBlock Text="{Binding Prestige, ElementName=Root}" FontSize="46" FontWeight="Bold"
                       Foreground="#F2D98A" Canvas.Left="1680" Canvas.Top="90"/>
        </Canvas>
    </Viewbox>
</UserControl>