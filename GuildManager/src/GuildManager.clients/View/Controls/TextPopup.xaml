<UserControl x:Class="GuildManager.Client.View.Controls.TextPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#AA000000" MouseLeftButtonDown="OnBackgroundClicked">
        <Border Background="#EFE0BE" BorderBrush="#3B2412" BorderThickness="2" CornerRadius="8"
                MaxWidth="620" MaxHeight="800" Padding="16"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MouseLeftButtonDown="OnPanelClicked">
            <TextBlock Name="MessageText" FontWeight="Bold" FontSize="18"
                       Foreground="#3B2412" HorizontalAlignment="Center" Margin="0,0,0,12"/>
        </Border>
    </Grid>
</UserControl>