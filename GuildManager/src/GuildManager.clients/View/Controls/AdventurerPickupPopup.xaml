<UserControl x:Class="GuildManager.Client.View.Controls.AdventurerPickerPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#AA000000" MouseLeftButtonDown="OnBackgroundClicked">
        <Border Background="#EFE0BE" BorderBrush="#3B2412" BorderThickness="2" CornerRadius="8"
                Width="420" MaxHeight="500" Padding="16"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MouseLeftButtonDown="OnPanelClicked">
            <StackPanel>
                <TextBlock Text="Choisir un aventurier" FontWeight="Bold" FontSize="18"
                           Foreground="#3B2412" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AdventurerList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F7EFD6" BorderBrush="#8A5A2A" BorderThickness="1"
                                        CornerRadius="4" Margin="0,4" Padding="10"
                                        MouseLeftButtonUp="OnAdventurerRowClicked" Cursor="Hand"
                                        Tag="{Binding}">
                                    <TextBlock Text="{Binding name}" FontSize="15" Foreground="#3B2412"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>