<UserControl x:Class="GuildManager.Client.View.Controls.QuestSummary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#AA000000" MouseLeftButtonDown="OnBackgroundClicked">
        <Border Background="#EFE0BE" BorderBrush="#3B2412" BorderThickness="2" CornerRadius="8"
                MaxWidth="620" MaxHeight="800" Padding="16"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MouseLeftButtonDown="OnPanelClicked">
            <StackPanel>
                <!-- Nom de la quête -->
                <TextBlock Name="QuestNameText" FontWeight="Bold" FontSize="20"
                           Foreground="#3B2412" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                <!-- Résultat : victoire / défaite -->
                <TextBlock Name="ResultText" FontWeight="Bold" FontSize="16"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <!-- Liste scrollable des aventuriers -->
                <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                    <ItemsControl Name="AdventurersList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#3B2412" BorderThickness="1" CornerRadius="4"
                                        Background="#F7EFD9" Padding="8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0" Source="{Binding PortraitPath}"
                                               Width="48" Height="48" Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                       FontSize="15" Foreground="#3B2412"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Foreground="#3B2412" FontSize="12">
                                                    <Run Text="Niveau "/>
                                                    <Run Text="{Binding Level, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text=" • " Foreground="#3B2412" FontSize="12"/>
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           Foreground="{Binding StatusColor}"
                                                           FontWeight="Bold" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                   FontWeight="Bold" Foreground="#2E7D32" FontSize="14">
                                            <Run Text="+"/>
                                            <Run Text="{Binding XpPerAdventurer,
                                                RelativeSource={RelativeSource AncestorType=UserControl},
                                                Mode=OneWay}"/>
                                            <Run Text=" xp"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Récompenses -->
                <Border BorderBrush="#3B2412" BorderThickness="1" CornerRadius="4"
                        Background="#F7EFD9" Padding="10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Name="GoldText" Foreground="#3B2412" FontWeight="Bold"
                                   FontSize="15" Margin="0,0,16,0"/>
                        <TextBlock Name="FoodText" Foreground="#3B2412" FontWeight="Bold"
                                   FontSize="15" Margin="0,0,16,0"/>
                        <TextBlock Name="PrestigeText" Foreground="#3B2412" FontWeight="Bold"
                                   FontSize="15"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>