<UserControl x:Class="GuildManager.Client.View.Controls.QuestCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Button Click="Button_Click" Background="Transparent" BorderThickness="0"
            Cursor="Hand" FocusVisualStyle="{x:Null}">
        <Button.Template>
            <ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate>
        </Button.Template>
        <Grid Width="220" Height="330">
            <Image x:Name="CardImage" Source="/Assets/UI/quest_icon.png" Stretch="Uniform"/>
            <StackPanel Margin="30,75,30,70" VerticalAlignment="Top">
                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="#3B2412"
                           HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#5C4A32"
                           TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Button>
</UserControl>