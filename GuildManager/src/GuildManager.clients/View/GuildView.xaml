<UserControl x:Class="GuildManager.Client.View.GuildView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GuildManager.Client.View.Controls">
    <Viewbox Stretch="Uniform">
        <Canvas Width="1536" Height="1024">
            <Image Source="/Assets/UI/guilde_background.png" Width="1536" Height="1024"/>

            <controls:HoverHotspot Canvas.Left="100" Canvas.Top="260"
                                   Width="520" Height="440"
                                   Clicked="OnQuestBoardClicked"/>
        </Canvas>
    </Viewbox>
</UserControl>