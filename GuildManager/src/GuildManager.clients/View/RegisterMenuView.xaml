<UserControl x:Class="GuildManager.Client.View.RegisterMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GuildManager.Client.View.Controls">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Inscription" Foreground="Gold" FontSize="28"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <controls:FantasyTextBox x:Name="UsernameBox" Width="400" Height="70" Margin="0,6"/>
            <controls:FantasyTextBox x:Name="EmailBox" Width="400" Height="70" Margin="0,6"/>
            <controls:FantasyTextBox x:Name="PasswordBox" Width="400" Height="70" Margin="0,6"/>
            <controls:FantasyTextBox x:Name="ConfirmPasswordBox" Width="400" Height="70" Margin="0,6"/>

            <TextBlock x:Name="StatusText" Foreground="OrangeRed" TextWrapping="Wrap"
                       HorizontalAlignment="Center" MaxWidth="400" Margin="0,10,0,0"/>

            <controls:FantasyMenuButton NormalImage="/Assets/UI/bouton_s'incrire.png"
                                         HoverImage="/Assets/UI/bouton_s'incrire_hover.png"
                                         Clicked="OnRegisterClicked" Width="300" Height="70" Margin="0,20,0,8"/>

            <controls:FantasyMenuButton NormalImage="/Assets/UI/bouton_retour.png"
                                         HoverImage="/Assets/UI/bouton_retour_hover.png"
                                         Clicked="OnBackClicked" Width="300" Height="70" Margin="0,8"/>
        </StackPanel>
    </Grid>
</UserControl>