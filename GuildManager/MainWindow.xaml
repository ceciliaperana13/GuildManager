<Window x:Class="MonProjet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GuildManager.Client.ViewModel"
        xmlns:v="clr-namespace:GuildManager.Client.View"
        Title="Guild Manager" Height="450" Width="800">
    <Grid>
        <Image Source="{Binding CurrentView.BackgroundPath}" Stretch="UniformToFill"/>
        <ContentControl Content="{Binding CurrentView}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type vm:MainMenuViewModel}">
                    <v:MainMenuView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:PlayMenuViewModel}">
                    <v:PlayMenuView />
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </Grid>
</Window>

